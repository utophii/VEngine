{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utophii.github.io/VEngine/schemas/effect.schema.json",
  "title": "VEngine effect",
  "description": "One VEngine YAML effect. Geometry formulas are checked by /ve validate on the server.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Registry name used by /ve play. Defaults to the file name without .yml."
    },
    "effect": {
      "type": "string",
      "minLength": 1,
      "description": "Name of a primitive supplied by a YAML atom or another plugin."
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "$ref": "#/$defs/formula",
      "description": "Default duration in ticks, or a formula resolved when played. 20 ticks equal one second."
    },
    "scale": {
      "$ref": "#/$defs/formula",
      "description": "Size multiplier, or a formula resolved when played."
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/formula"
      },
      "description": "Named numeric parameters or formulas resolved when played."
    },
    "particle": {
      "type": "string",
      "minLength": 1,
      "description": "Bukkit particle name, checked against the installed server by /ve validate."
    },
    "material": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "$ref": "#/$defs/number",
      "description": "Start time in ticks."
    },
    "delay": {
      "$ref": "#/$defs/number",
      "description": "Additional delay in ticks after the referenced layer."
    },
    "rotationYaw": {
      "$ref": "#/$defs/number"
    },
    "rotationPitch": {
      "$ref": "#/$defs/number"
    },
    "rotationRoll": {
      "$ref": "#/$defs/number"
    },
    "tiltAngle": {
      "$ref": "#/$defs/number"
    },
    "dustSize": {
      "$ref": "#/$defs/number"
    },
    "count": {
      "$ref": "#/$defs/number"
    },
    "speed": {
      "$ref": "#/$defs/number"
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "toColor": {
      "$ref": "#/$defs/color"
    },
    "transitionColor": {
      "$ref": "#/$defs/color"
    },
    "after": {
      "type": "string",
      "minLength": 1,
      "description": "Layer ID to start after. Used inside layers."
    },
    "tiltAxis": {
      "$ref": "#/$defs/vector"
    },
    "offset": {
      "$ref": "#/$defs/offset"
    },
    "gradient": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/color"
      },
      "minItems": 0
    },
    "gradientInterpolation": {
      "type": "string",
      "enum": [
        "rgb",
        "hsv",
        "RGB",
        "HSV"
      ]
    },
    "colorOverLife": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/color"
      },
      "minItems": 0
    },
    "sizeOverLife": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 0
    },
    "display": {
      "$ref": "#/$defs/display"
    },
    "follow": {
      "$ref": "#/$defs/follow",
      "description": "Default attachment and orientation when played by an entity."
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modifier"
      },
      "minItems": 0
    },
    "animation": {
      "$ref": "#/$defs/animation",
      "description": "Numeric keyframe tracks for a layer."
    },
    "budget": {
      "type": "string",
      "enum": [
        "normal",
        "exempt"
      ],
      "description": "Use exempt to bypass particle limits and automatic quality reduction."
    },
    "lod": {
      "type": "boolean",
      "description": "Whether distance-based particle thinning applies."
    },
    "curve": {
      "$ref": "#/$defs/parametric",
      "description": "Parametric curve, by default sampled over t."
    },
    "surface": {
      "$ref": "#/$defs/parametric",
      "description": "Parametric surface, by default sampled over u and v."
    },
    "sdf": {
      "$ref": "#/$defs/sdf",
      "description": "Implicit surface defined by a scalar formula."
    },
    "lsystem": {
      "$ref": "#/$defs/lsystem",
      "description": "Turtle geometry generated from symbol replacement rules."
    },
    "shape": {
      "$ref": "#/$defs/shape",
      "description": "Imported image, OBJ, SVG, or text geometry from the shapes directory."
    },
    "points": {
      "$ref": "#/$defs/points",
      "description": "Independent points computed from formulas."
    },
    "ode": {
      "$ref": "#/$defs/ode",
      "description": "Numerically integrated state and derivative formulas."
    },
    "iteration": {
      "$ref": "#/$defs/iteration",
      "description": "Iterated formula branches for fractals and similar generators."
    },
    "field": {
      "$ref": "#/$defs/field",
      "description": "Points distributed according to a scalar field."
    },
    "functions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/formula"
      },
      "description": "Reusable math functions, mapping signatures such as wave(t) to formulas."
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "minItems": 1,
      "description": "Timed layers, each using a named primitive or one inline geometry block."
    },
    "emitters": {
      "$ref": "#/$defs/emitters",
      "description": "Child effects spawned while this layered effect runs."
    },
    "then": {
      "$ref": "#/$defs/emitters",
      "description": "Child effects spawned after this layered effect ends."
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "layers"
      ]
    },
    {
      "required": [
        "effect"
      ]
    },
    {
      "required": [
        "curve"
      ]
    },
    {
      "required": [
        "surface"
      ]
    },
    {
      "required": [
        "sdf"
      ]
    },
    {
      "required": [
        "lsystem"
      ]
    },
    {
      "required": [
        "shape"
      ]
    },
    {
      "required": [
        "points"
      ]
    },
    {
      "required": [
        "ode"
      ]
    },
    {
      "required": [
        "iteration"
      ]
    },
    {
      "required": [
        "field"
      ]
    }
  ],
  "$defs": {
    "number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
        }
      ]
    },
    "formula": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "vector": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/number"
        },
        "y": {
          "$ref": "#/$defs/number"
        },
        "z": {
          "$ref": "#/$defs/number"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "offset": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "x": {
              "$ref": "#/$defs/number"
            },
            "y": {
              "$ref": "#/$defs/number"
            },
            "z": {
              "$ref": "#/$defs/number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "color": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#?[0-9a-fA-F]{6}$"
        },
        {
          "type": "object",
          "properties": {
            "r": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "g": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "additionalProperties": false,
          "required": [
            "r",
            "g",
            "b"
          ]
        }
      ]
    },
    "follow": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "offset": {
              "$ref": "#/$defs/offset"
            },
            "rotation": {
              "type": "string",
              "enum": [
                "none",
                "body",
                "head",
                "look",
                "velocity",
                "NONE",
                "BODY",
                "HEAD",
                "LOOK",
                "VELOCITY"
              ]
            },
            "stopWithEntity": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "display": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "item",
            "block",
            "text",
            "pixel",
            "ribbon",
            "ITEM",
            "BLOCK",
            "TEXT",
            "PIXEL",
            "RIBBON"
          ]
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            }
          ]
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/number"
            },
            {
              "$ref": "#/$defs/vector"
            }
          ]
        },
        "rotation": {
          "$ref": "#/$defs/vector"
        },
        "spin": {
          "$ref": "#/$defs/vector"
        },
        "phase": {
          "$ref": "#/$defs/number"
        },
        "billboard": {
          "type": "string",
          "enum": [
            "fixed",
            "vertical",
            "horizontal",
            "center",
            "FIXED",
            "VERTICAL",
            "HORIZONTAL",
            "CENTER"
          ]
        },
        "brightness": {
          "anyOf": [
            {
              "$ref": "#/$defs/number"
            },
            {
              "type": "object",
              "properties": {
                "block": {
                  "$ref": "#/$defs/number"
                },
                "sky": {
                  "$ref": "#/$defs/number"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "glow": {
          "$ref": "#/$defs/color"
        },
        "interpolation": {
          "$ref": "#/$defs/number"
        },
        "viewRange": {
          "$ref": "#/$defs/number"
        },
        "shadow": {
          "type": "object",
          "properties": {
            "radius": {
              "$ref": "#/$defs/number"
            },
            "strength": {
              "$ref": "#/$defs/number"
            }
          },
          "additionalProperties": false
        },
        "background": {
          "type": "string",
          "pattern": "^#?(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "textShadow": {
          "type": "boolean"
        },
        "seeThrough": {
          "type": "boolean"
        },
        "particles": {
          "type": "boolean"
        },
        "width": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          ]
        },
        "opacity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          ]
        },
        "normal": {
          "$ref": "#/$defs/vector"
        }
      },
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "tick": {
          "$ref": "#/$defs/number"
        },
        "value": {
          "$ref": "#/$defs/number"
        },
        "easing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "tick",
        "value"
      ]
    },
    "track": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "loop": {
          "type": "boolean"
        },
        "easing": {
          "type": "string",
          "minLength": 1
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "keyframes"
      ]
    },
    "animation": {
      "type": "object",
      "properties": {
        "loop": {
          "type": "boolean"
        },
        "easing": {
          "type": "string",
          "minLength": 1
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "tracks"
      ]
    },
    "modifier": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "turbulence",
            "rotation",
            "vortex",
            "flocking",
            "motion"
          ]
        },
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "separation": {"type": "number", "minimum": 0},
        "alignment": {"type": "number", "minimum": 0},
        "cohesion": {"type": "number", "minimum": 0},
        "maxSpeed": {"type": "number", "exclusiveMinimum": 0},
        "seed": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "strength": {
          "$ref": "#/$defs/number"
        },
        "frequency": {
          "$ref": "#/$defs/number"
        },
        "octaves": {
          "$ref": "#/$defs/number"
        },
        "angularVelocity": {
          "$ref": "#/$defs/number"
        },
        "angularSpeed": {
          "$ref": "#/$defs/number"
        },
        "initialAngle": {
          "$ref": "#/$defs/number"
        },
        "coreRadius": {
          "$ref": "#/$defs/number"
        },
        "axis": {
          "$ref": "#/$defs/vector"
        },
        "pivotOffset": {
          "$ref": "#/$defs/vector"
        },
        "mode": {
          "type": "string",
          "enum": [
            "hold",
            "loop",
            "ping_pong",
            "ping-pong"
          ]
        },
        "easing": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "$ref": "#/$defs/number"
              },
              "y": {
                "$ref": "#/$defs/number"
              },
              "z": {
                "$ref": "#/$defs/number"
              },
              "ticks": {
                "$ref": "#/$defs/number"
              },
              "easing": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "ticks"
            ]
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "emitter": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "effect": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "$ref": "#/$defs/number"
            },
            "delay": {
              "$ref": "#/$defs/number"
            },
            "every": {
              "$ref": "#/$defs/number"
            },
            "count": {
              "$ref": "#/$defs/number"
            },
            "scale": {
              "$ref": "#/$defs/number"
            },
            "duration": {
              "$ref": "#/$defs/number"
            },
            "offset": {
              "$ref": "#/$defs/offset"
            }
          },
          "additionalProperties": false,
          "required": [
            "effect"
          ]
        }
      ]
    },
    "emitters": {
      "anyOf": [
        {
          "$ref": "#/$defs/emitter"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emitter"
          },
          "minItems": 1
        }
      ]
    },
    "parametric": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/formula"
        },
        "y": {
          "$ref": "#/$defs/formula"
        },
        "z": {
          "$ref": "#/$defs/formula"
        },
        "value": {
          "$ref": "#/$defs/formula"
        },
        "age": {
          "$ref": "#/$defs/formula"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "samples": {
          "anyOf": [
            {
              "$ref": "#/$defs/number"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/number"
              },
              "minItems": 1
            }
          ]
        },
        "samplesX": {
          "$ref": "#/$defs/number"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "min": {
                "$ref": "#/$defs/number"
              },
              "max": {
                "$ref": "#/$defs/number"
              }
            },
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ]
          },
          "minItems": 0
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
              }
            ]
          }
        },
        "angularSpeed": {
          "$ref": "#/$defs/number"
        }
      },
      "additionalProperties": false
    },
    "sdf": {
      "type": "object",
      "properties": {
        "f": {
          "$ref": "#/$defs/formula"
        },
        "value": {
          "$ref": "#/$defs/formula"
        },
        "bounds": {
          "$ref": "#/$defs/number"
        },
        "points": {
          "$ref": "#/$defs/number"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
              }
            ]
          }
        },
        "angularSpeed": {
          "$ref": "#/$defs/number"
        }
      },
      "additionalProperties": false,
      "required": [
        "f"
      ]
    },
    "lsystem": {
      "type": "object",
      "properties": {
        "axiom": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "to": {
                          "type": "string"
                        },
                        "weight": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "to"
                      ]
                    }
                  ]
                },
                "minItems": 1
              }
            ]
          }
        },
        "iterations": {
          "$ref": "#/$defs/number"
        },
        "angle": {
          "$ref": "#/$defs/number"
        },
        "size": {
          "$ref": "#/$defs/number"
        },
        "spacing": {
          "$ref": "#/$defs/number"
        },
        "points": {
          "$ref": "#/$defs/number"
        },
        "growth": {
          "$ref": "#/$defs/number"
        },
        "seed": {
          "$ref": "#/$defs/number"
        },
        "angularSpeed": {
          "$ref": "#/$defs/number"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "base",
            "center"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "axiom"
      ]
    },
    "shape": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "obj": {
          "type": "string",
          "minLength": 1
        },
        "svg": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "$ref": "#/$defs/number"
        },
        "points": {
          "$ref": "#/$defs/number"
        },
        "growth": {
          "$ref": "#/$defs/number"
        },
        "angularSpeed": {
          "$ref": "#/$defs/number"
        },
        "alpha": {
          "$ref": "#/$defs/number"
        },
        "tolerance": {
          "$ref": "#/$defs/number"
        },
        "samples": {
          "$ref": "#/$defs/number"
        },
        "epicycles": {
          "$ref": "#/$defs/number"
        },
        "period": {
          "$ref": "#/$defs/number"
        },
        "trail": {
          "$ref": "#/$defs/number"
        },
        "spacing": {
          "$ref": "#/$defs/number"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "base",
            "center"
